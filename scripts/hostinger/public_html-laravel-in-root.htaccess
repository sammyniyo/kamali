# Use when the FULL Laravel project is inside public_html (Git deploy to public_html).
# Copy to: public_html/.htaccess

<IfModule mod_rewrite.c>
    Options +FollowSymLinks -MultiViews -Indexes
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
