# Use when Laravel is in public_html/kamali/ (sibling of this .htaccess in public_html).
# Copy to: public_html/.htaccess

<IfModule mod_rewrite.c>
    Options +FollowSymLinks -MultiViews -Indexes
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/kamali/public/
    RewriteRule ^(.*)$ kamali/public/$1 [L]
</IfModule>
