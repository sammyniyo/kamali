APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: set APP_DEBUG=false so visitors see generic error pages (no stack traces or Ignition).
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Production: APP_URL=https://www.kamaliarchitects.com

# Studio contact (optional — defaults are in config/kamali.php)
# KAMALI_PHONE_DISPLAY="+250 780 525 403"
# KAMALI_PHONE_TEL="+250780525403"
# KAMALI_EMAIL=sales@kamaliarchitects.com
# KAMALI_WEBSITE_URL=https://www.kamaliarchitects.com
# KAMALI_WEBSITE_HOST=www.kamaliarchitects.com
# KAMALI_MAP_QUERY="KN 7 St, Kigali, Rwanda"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hostinger: write uploads directly to the web folder (no storage:link needed)
# FILESYSTEM_PUBLIC_ROOT=/home/USER/domains/example.com/public_html/public/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
